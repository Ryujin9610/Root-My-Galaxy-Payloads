+    }
 #else
     rc = register_kprobe(&reboot_kp);
     if (rc) {
@@ -143,7 +153,10 @@ void __init ksu_supercalls_init(void)
 void __exit ksu_supercalls_exit(void)
 {
 #ifdef CONFIG_KSU_LEGACY_SELINUX
-    misc_deregister(&legacy_ksu_device);
+    if (legacy_ksu_proc)
+        proc_remove(legacy_ksu_proc);
+    if (legacy_ksu_misc_registered)
+        misc_deregister(&legacy_ksu_device);
 #else
     unregister_kprobe(&reboot_kp);
 #endif
