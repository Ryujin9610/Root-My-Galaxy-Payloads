 #include <linux/syscalls.h>
@@ -48,6 +49,8 @@ static struct miscdevice legacy_ksu_device = {
     .fops = &anon_ksu_fops,
     .mode = 0666,
 };
+static bool legacy_ksu_misc_registered;
+static struct proc_dir_entry *legacy_ksu_proc;
